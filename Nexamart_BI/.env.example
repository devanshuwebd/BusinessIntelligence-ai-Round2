# Copy to .env locally; never commit real values.
NEXAMART_ENV=development
NEXAMART_API_TOKEN=
# Optional production role tokens, e.g. {"Executive":"...","Analyst":"..."}
NEXAMART_ROLE_TOKENS={}
# Development fallback uses evidence-only persona-specific narration when this is empty.
NEXAMART_DEMO_MODE=1
NEXAMART_LLM_URL=http://127.0.0.1:11435/api/generate
NEXAMART_LLM_TOKEN=
NEXAMART_LLM_MODEL=qwen2.5:7b
NEXAMART_LLM_INPUT_COST_PER_1K=0
NEXAMART_LLM_OUTPUT_COST_PER_1K=0
NEXAMART_DATA_AS_OF=
NEXAMART_API_URL=http://127.0.0.1:8000/api
